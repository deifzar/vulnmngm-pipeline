#!/bin/bash
# Retrieve PostgreSQL password from Azure Key Vault using managed identity

# Login with managed identity (only needed first time)
az login --identity 2>/dev/null

# Get password from Key Vault
PASSWORD=$(az keyvault secret show \
  --vault-name {{ azure_keyvault_secrets }} \
  --name {{ sonarquebe_psql_secret_name }} \
  --query value \
  --output tsv 2>/dev/null)

if [ -z "$PASSWORD" ]; then
  echo "ERROR: Failed to retrieve password from Key Vault"
  exit 1
fi

# Update SonarQube configuration
sed -i "s|^sonar.jdbc.password=.*|sonar.jdbc.password=$PASSWORD|" {{ sonarqube_install_dir }}/conf/sonar.properties

echo "✅ Database password updated from Key Vault"