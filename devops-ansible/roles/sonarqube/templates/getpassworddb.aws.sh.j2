#!/bin/bash
# Retrieve PostgreSQL password from AWS Secrets Manager

# Use full path - /usr/local/bin may not be in PATH when run via systemd
PASSWORD=$(aws secretsmanager get-secret-value \
  --secret-id "{{ sonarquebe_psql_secret_name }}" \
  --region "{{ region }}" \
  --query 'SecretString' \
  --output text 2>/dev/null)

if [ -z "$PASSWORD" ]; then
  echo "ERROR: Failed to retrieve password from AWS Secrets Manager"
  exit 1
fi

# Update SonarQube configuration
sed -i "s|^sonar.jdbc.password=.*|sonar.jdbc.password=$PASSWORD|" {{ sonarqube_install_dir }}/conf/sonar.properties

echo "✅ Database password updated from AWS Secrets Manager"